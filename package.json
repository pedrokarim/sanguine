{
  "name": "sanguine",
  "version": "1.0.0",
  "private": true,
  "description": "Sanguine — un survivor-like jouable dans le navigateur. Zéro dépendance runtime, tous les assets générés par le code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "planche": "vite build --config vite.planche.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "packageManager": "pnpm@9.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrokarim/sanguine.git"
  }
}
